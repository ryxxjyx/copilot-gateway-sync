{
  "name": "copilot-gateway-sync",
  "displayName": "Copilot 网关模型同步",
  "description": "通用网关模型管理、选择增删、完整能力检测与思维级别配置。",
  "version": "0.4.5",
  "publisher": "jiangyx",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryxxjyx/copilot-gateway-sync.git"
  },
  "homepage": "https://github.com/ryxxjyx/copilot-gateway-sync#readme",
  "bugs": {
    "url": "https://github.com/ryxxjyx/copilot-gateway-sync/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other"],
  "extensionKind": ["ui"],
  "main": "./dist/extension.js",
  "activationEvents": ["onCommand:gatewaySync.open", "onCommand:gatewaySync.sync", "onStartupFinished"],
  "contributes": {
    "commands": [{
      "command": "gatewaySync.open",
      "title": "Copilot: 打开网关模型同步"
    }, {
      "command": "gatewaySync.sync",
      "title": "Copilot: 立即同步网关模型"
    }],
    "configuration": {
      "title": "Copilot 网关模型同步",
      "properties": {
        "gatewaySync.intervalMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 1440,
          "markdownDescription": "[**打开网关模型管理**](command:gatewaySync.open) — 管理供应商地址、API Key、默认模板、检测和模型应用，在单独管理标签页打开。此项为保留的旧版设置，当前不控制自动刷新；实际自动刷新开关及间隔请在管理面板中按供应商配置。"
        }
      }
    }
  },
  "scripts": {
    "build": "bun tools/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "package": "bun tools/package.mjs"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "undici": "5.29.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.80.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "typescript": "^5.8.0"
  }
}
